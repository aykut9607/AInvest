{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.16",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "set NODE_OPTIONS=--dns-result-order=ipv4first&& expo start --port 8099 --localhost",
    "android": "set NODE_OPTIONS=--dns-result-order=ipv4first&& expo start --android --port 8099 --localhost",
    "ios": "expo start --ios --port 8099",
    "ports": "%ANDROID_HOME%\\platform-tools\\adb reverse tcp:5000 tcp:5000",
    "typecheck": "tsc --noEmit"
  },
  "private": true
}
