# every call goes through the Edge Gateway (JWT, BOLA, rate limits); its CORS policy allows http://localhost:5173
VITE_GATEWAY_URL=http://localhost:5000
# mock = example proposal from contracts/schemas/portfolio-proposal.draft.schema.json
# service = GET /api/portfolio/{userId}/latest through the gateway (once the Portfolio Service exists)
VITE_PORTFOLIO_SOURCE=mock
