{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // must match JwtService.ISSUER / AUDIENCE in Identity. The signing secret is NOT here:
  // it lives in user-secrets (Jwt:Secret) and must be the same string as Identity's JWT_SECRET
  "Jwt": {
    "Issuer": "ainvest-identity",
    "Audience": "ainvest-api"
  },

  // login attempts per client IP per window (MITRE T1110 brute force); the 6th attempt in a minute gets 429
  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },

  // the only address clients use; each route sends a URL pattern to one cluster (= one downstream service).
  // Deliberately NOT routed: GET /api/Profiles (lists every profile) and POST /api/financial-iq/calculate
  // (only Finance calls it, service to service) - what the gateway does not route cannot be reached from outside.
  // AuthorizationPolicy: "anonymous" = no token needed (register/login/refresh), "default" = any valid token,
  // "sameUser" = valid token AND the {userId} in the URL is the caller's own id (see Program.cs)
  "ReverseProxy": {
    "Routes": {
      // a literal path wins over the {**rest} pattern below, so POST /auth/login always gets the rate limit
      "identity-login": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "login",
        "Match": { "Path": "/auth/login", "Methods": [ "POST" ] }
      },
      "identity-auth": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/auth/{**rest}" }
      },
      "finance-profiles": {
        "ClusterId": "finance",
        "AuthorizationPolicy": "sameUser",
        "Match": { "Path": "/api/Profiles/{userId}/{**rest}" }
      },
      "iq-read": {
        "ClusterId": "iq",
        "AuthorizationPolicy": "sameUser",
        "Match": { "Path": "/api/financial-iq/{userId}/{**rest}", "Methods": [ "GET" ] }
      },
      "ai-explain": {
        "ClusterId": "ai",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/ai/{**rest}" }
      }
    },
    "Clusters": {
      "identity": { "Destinations": { "d1": { "Address": "http://localhost:8081/" } } },
      "finance": { "Destinations": { "d1": { "Address": "http://localhost:5293/" } } },
      "iq": { "Destinations": { "d1": { "Address": "http://localhost:5109/" } } },
      "ai": { "Destinations": { "d1": { "Address": "http://localhost:8001/" } } }
    }
  }
}
