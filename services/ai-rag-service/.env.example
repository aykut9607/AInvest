# copy to .env (git-ignored); every value has this default in core/config.py
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
LLM_TIMEOUT_SECONDS=60
# false -> templates only, no model calls
LLM_ENABLED=true
# user data is read through the gateway with the caller's token
GATEWAY_BASE_URL=http://localhost:5000
GATEWAY_TIMEOUT_SECONDS=5
# router (code picks the data, the model phrases it) or tools (the model calls the tools)
ASSISTANT_MODE=router
ASSISTANT_TOOLS_MODEL=llama3.1:8b
# sample until the Portfolio Service exists, then gateway
PORTFOLIO_SOURCE=sample
