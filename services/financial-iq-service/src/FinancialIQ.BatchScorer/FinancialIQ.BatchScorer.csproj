<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline evaluation tool: scores a JSON file of synthetic profiles with the real Financial IQ rules
       (FinancialIqCommandManager.CalculateScore). No database, no HTTP: the scoring code is called directly,
       so the evaluation measures the production rules, not a copy of them. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FinancialIQ.Api\FinancialIQ.Api.csproj" />
  </ItemGroup>

</Project>
